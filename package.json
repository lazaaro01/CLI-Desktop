{
  "name": "gemini-cli-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "electron": "node node_modules/electron/cli.js .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node node_modules/electron/cli.js .\""
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.5.1"
  }
}
